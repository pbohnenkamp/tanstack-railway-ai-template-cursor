#!/usr/bin/env sh
set -e

# Match CI `pnpm check` (prettier --check .) by writing first, then failing
# if Prettier errored or reformatted anything that still needs staging.

echo "pre-commit: prettier --write ."
pnpm exec prettier --write .

if ! git diff --quiet; then
  echo ""
  echo "pre-commit: Prettier updated files. Stage them and commit again:"
  echo ""
  git --no-pager diff --stat
  echo ""
  exit 1
fi
