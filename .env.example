# Clerk
# Leave empty (or use placeholders) to explore the template without auth.
# Auth middleware and Clerk UI stay disabled until both keys look valid
# (pk_test_/pk_live_ and sk_test_/sk_live_). A critical warning is logged
# on the server and a banner is shown in the UI while bypassed.
#
# Clerk publishable key (required for auth)
VITE_CLERK_PUBLISHABLE_KEY=
# Clerk secret key (required for auth)
CLERK_SECRET_KEY=

# Local Postgres from compose.yaml. Start it with `pnpm db:up`, then apply the
# schema with `pnpm db:setup`. Deployed environments (Railway, etc.) set this
# to their managed Postgres connection string and never use compose.yaml.
# Unprefixed — server-only; never add a VITE_ prefix.
#
# Manual / pnpm dev / e2e use database `app`. Integration tests use `app_test`
# on the same Compose server (see docs/testing-strategy.md) — do not point this
# default URL at app_test.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/app
